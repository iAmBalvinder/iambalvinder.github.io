---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date?: Date;
  tags?: string[];
  backHref: string;
  backLabel: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, date, tags = [], backHref, backLabel, jsonLd } = Astro.props;

const dateFormatted = date
  ? new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(date)
  : undefined;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">
    <a
      href={backHref}
      class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-fg"
    >
      <span aria-hidden="true">&larr;</span> {backLabel}
    </a>
    <header class="mt-8">
      {
        dateFormatted && (
          <p class="text-sm font-medium tracking-widest text-accent uppercase">{dateFormatted}</p>
        )
      }
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>
      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tags">
            {tags.map((tag) => (
              <li class="rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div
      class="prose prose-invert mt-10 max-w-none
        prose-headings:font-semibold prose-headings:tracking-tight
        prose-a:text-accent prose-a:no-underline prose-a:hover:underline
        prose-strong:text-fg
        prose-code:rounded prose-code:bg-surface prose-code:px-1 prose-code:before:hidden prose-code:after:hidden
        prose-li:text-muted prose-p:text-muted"
    >
      <slot />
    </div>
    {
      tags.length > 0 && (
        <footer class="mt-12 border-t border-line/70 pt-6">
          <a
            href={backHref}
            class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-fg"
          >
            <span aria-hidden="true">&larr;</span> {backLabel}
          </a>
        </footer>
      )
    }
  </article>
</BaseLayout>
