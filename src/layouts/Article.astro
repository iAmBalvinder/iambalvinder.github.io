---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date?: Date;
  tags?: string[];
  backHref: string;
  backLabel: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, date, tags = [], backHref, backLabel, jsonLd } = Astro.props;

const dateFormatted = date
  ? new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(date)
  : undefined;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">
    <a
      href={backHref}
      class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-widest text-muted transition-colors hover:text-fg"
    >
      <span aria-hidden="true">&larr;</span> {backLabel}
    </a>
    <header class="mt-10">
      {
        dateFormatted && (
          <p class="font-mono text-xs uppercase tracking-widest text-accent">{dateFormatted}</p>
        )
      }
      <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight tracking-tight text-fg sm:text-5xl">
        {title}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-muted">{description}</p>
      {
        tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-x-3 gap-y-2 font-mono text-xs text-muted" aria-label="Tags">
            {tags.map((tag) => <li>{`[ ${tag} ]`}</li>)}
          </ul>
        )
      }
    </header>
    <div
      class="prose prose-headings:font-serif dark:prose-invert mt-12 max-w-none
        prose-headings:font-semibold prose-headings:tracking-tight
        prose-a:text-accent prose-a:no-underline prose-a:hover:underline
        prose-strong:text-fg
        prose-code:rounded prose-code:bg-surface prose-code:px-1 prose-code:before:hidden prose-code:after:hidden
        prose-li:text-muted prose-p:text-muted"
    >
      <slot />
    </div>
    <footer class="mt-14 border-t border-line pt-6">
      <a
        href={backHref}
        class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-widest text-muted transition-colors hover:text-fg"
      >
        <span aria-hidden="true">&larr;</span> {backLabel}
      </a>
    </footer>
  </article>
</BaseLayout>
