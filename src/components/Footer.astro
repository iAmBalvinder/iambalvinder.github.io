---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line/70">
  <div class="mx-auto max-w-5xl px-6 py-12">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <p class="font-semibold text-fg">
          Balvinder Singh<span class="text-accent">.</span>
        </p>
        <p class="mt-2 text-sm text-muted">
          Helping teams turn data platforms into production AI systems.
        </p>
      </div>
      <div class="flex gap-16">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Site</p>
          <ul class="mt-3 space-y-2 text-sm">
            {
              site.nav.map((item) => (
                <li>
                  <a href={item.href} class="text-muted transition-colors hover:text-fg">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Elsewhere</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a
                href={`mailto:${site.email}`}
                class="text-muted transition-colors hover:text-fg"
              >
                Email
              </a>
            </li>
            <li>
              <a
                href={site.socials.linkedin}
                class="text-muted transition-colors hover:text-fg"
                rel="me"
              >
                LinkedIn
              </a>
            </li>
            <li>
              <a
                href={site.socials.github}
                class="text-muted transition-colors hover:text-fg"
                rel="me"
              >
                GitHub
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-line/70 pt-6 text-xs text-muted sm:flex-row sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>Built with Astro, deployed on GitHub Pages.</p>
    </div>
  </div>
</footer>
