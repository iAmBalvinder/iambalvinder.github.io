---
import { site } from '../data/site';

interface Props {
  title?: string;
  body?: string;
}

const {
  title = 'Have data, need AI?',
  body = 'Tell me what you are building and where it is stuck. If I can help, we will figure out the fastest path from prototype to production.',
} = Astro.props;
---

<section class="border-t border-line">
  <div class="mx-auto max-w-5xl px-6 py-20 text-center sm:py-24">
    <p class="font-mono text-xs uppercase tracking-widest text-accent">Next step</p>
    <h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
      {title}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-muted">{body}</p>
    <a
      href={`mailto:${site.email}?subject=Consulting%20inquiry`}
      class="mt-8 inline-flex items-center rounded-[3px] bg-fg px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent"
    >
      Book a call
    </a>
    <p class="mt-4 font-mono text-xs uppercase tracking-widest text-muted">
      Usually replies within 1-2 business days
    </p>
  </div>
</section>
