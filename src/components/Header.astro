---
import { site } from '../data/site';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-6">
    <a
      href="/"
      class="shrink-0 font-serif text-lg font-semibold tracking-tight text-fg"
      aria-label="Balvinder Singh - home"
    >
      <span class="sm:hidden">BS<span class="text-accent">.</span></span>
      <span class="hidden sm:inline">Balvinder Singh<span class="text-accent">.</span></span>
    </a>
    <nav
      aria-label="Main"
      class="no-scrollbar flex items-center gap-4 overflow-x-auto sm:gap-5"
    >
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'shrink-0 font-mono text-xs uppercase tracking-widest transition-colors',
              isActive(item.href) ? 'text-accent' : 'text-muted hover:text-fg',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
