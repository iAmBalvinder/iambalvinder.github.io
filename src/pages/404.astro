---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="mx-auto max-w-3xl px-6 pt-32 pb-24 text-center sm:pt-40">
    <p class="font-mono text-xs uppercase tracking-widest text-accent">404</p>
    <h1 class="mt-4 font-serif text-5xl font-semibold tracking-tight text-fg sm:text-6xl">
      Page not found
    </h1>
    <p class="mx-auto mt-6 max-w-md text-lg text-muted">
      The page you are looking for does not exist or has moved.
    </p>
    <div class="mt-10 flex justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center rounded-[3px] bg-fg px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent"
      >
        Back home
      </a>
      <a
        href="/contact/"
        class="inline-flex items-center rounded-[3px] border border-fg/25 px-6 py-3 text-sm font-medium text-fg transition-colors hover:border-fg"
      >
        Contact
      </a>
    </div>
  </section>
</BaseLayout>
