---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="mx-auto max-w-3xl px-6 pt-32 pb-24 text-center sm:pt-40">
    <p class="text-sm font-medium tracking-widest text-accent uppercase">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Page not found</h1>
    <p class="mx-auto mt-6 max-w-md text-lg text-muted">
      The page you are looking for does not exist or has moved.
    </p>
    <div class="mt-10 flex justify-center gap-4">
      <a
        href="/"
        class="inline-flex items-center rounded-xl bg-accent px-6 py-3 font-semibold text-bg transition-colors hover:bg-accent-strong"
      >
        Back home
      </a>
      <a
        href="/contact/"
        class="inline-flex items-center rounded-xl border border-line px-6 py-3 font-semibold text-fg transition-colors hover:border-accent/50"
      >
        Contact
      </a>
    </div>
  </section>
</BaseLayout>
