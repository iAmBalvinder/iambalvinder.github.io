---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import { site } from '../data/site';

const stack = [
  'SQL',
  'Python',
  'Power BI',
  'Tableau',
  'SSAS / MDX',
  'Statistics',
  'AI/ML fundamentals',
];

const principles = [
  {
    title: 'Measure before you build',
    body: 'Every AI system needs a number that tells you whether it is working. Define it before writing a line of code.',
  },
  {
    title: 'Data quality beats model choice',
    body: 'Teams reach for a bigger model when the real problem is a messy retrieval corpus. Fix the data layer first.',
  },
  {
    title: 'Boring where possible',
    body: 'Managed services and proven patterns over novel architecture. Save the experimentation for where it pays.',
  },
  {
    title: 'Evals, not vibes',
    body: 'Demo success means nothing. Automated evaluation suites that catch regressions are what make LLM features shippable.',
  },
];
---

<BaseLayout
  title="About"
  description="From a decade of project management and data work to LLM and AI engineering. The story, the principles, and the stack."
>
  <section class="mx-auto max-w-3xl px-6 pt-24 pb-14 sm:pt-32">
    <p class="font-mono text-xs uppercase tracking-widest text-accent">About</p>
    <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight tracking-tight text-fg sm:text-5xl">
      The data engineer who ships AI systems
    </h1>
    <div class="mt-10 space-y-6 text-lg leading-relaxed text-muted">
      <p>
        Hi, I am {site.name}. I started out far from AI: an Industrial Engineering
        degree and an MBA in Operations Management from Thapar University
        (2007-2012), followed by years of project and portfolio management across
        multiple countries and geographies.
      </p>
      <p>
        In 2017 I found my real calling in data and analytics, and have been
        building with data ever since - pipelines, analytics platforms, and
        reporting for organizations including
        <span class="text-fg">Scarsin Corporation</span> in the Toronto region.
      </p>
      <p>
        Now I am focused on the next layer up: LLM and AI engineering. The shift
        feels natural rather than dramatic, because the hard part of production AI
        is not the model. It is the data quality, the pipelines, the evaluation
        discipline - the problems I have spent years learning to solve.
      </p>
      <p>
        When I am not working, I am out with a camera, biking, or doing the
        occasional real estate deal.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-14">
    <p class="font-mono text-xs uppercase tracking-widest text-muted">Stack I work with</p>
    <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-2 font-mono text-xs text-muted">
      {stack.map((item) => <li>{`[ ${item} ]`}</li>)}
    </ul>
  </section>

  <section class="border-t border-line" aria-labelledby="principles">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <p class="font-mono text-xs uppercase tracking-widest text-muted">How I work</p>
      <h2 id="principles" class="mt-4 font-serif text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
        Four rules I hold myself to
      </h2>
      <div class="mt-10 border-t border-line">
        {
          principles.map((principle, index) => (
            <div class="grid gap-2 border-b border-line py-8 transition-colors hover:bg-surface sm:grid-cols-[5rem_1fr] sm:gap-8">
              <span class="pt-1 font-mono text-xs text-muted">{`0${index + 1}`}</span>
              <div>
                <h3 class="font-serif text-xl font-semibold tracking-tight text-fg">{principle.title}</h3>
                <p class="mt-2 max-w-2xl leading-relaxed text-muted">{principle.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    title="Working on something similar?"
    body="Whether it is a production LLM feature or a data platform question, I am happy to talk it through."
  />
</BaseLayout>
