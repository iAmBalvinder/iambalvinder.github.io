---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const intake = [
  'What are you building, and for whom?',
  'Where is it stuck today - demo, prototype, or production?',
  'What does your current data stack look like?',
  'What is the timeline you are working against?',
];
---

<BaseLayout
  title="Contact"
  description="Get in touch about LLM and AI consulting: architecture reviews, RAG and eval pipelines, data platform enablement, and roadmaps."
>
  <section class="mx-auto max-w-3xl px-6 pt-24 pb-20 sm:pt-32">
    <p class="font-mono text-xs uppercase tracking-widest text-accent">Contact</p>
    <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight tracking-tight text-fg sm:text-5xl">
      Let's talk about your project
    </h1>
    <p class="mt-8 text-lg leading-relaxed text-muted">
      The fastest way to reach me is email. Include a few lines about your project
      and I will reply within one or two business days. If it looks like a fit,
      the first call is free.
    </p>

    <div class="mt-10">
      <a
        href={`mailto:${site.email}?subject=Consulting%20inquiry`}
        class="inline-flex items-center rounded-[3px] bg-fg px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent"
      >
        Email {site.email}
      </a>
    </div>

    <div class="mt-16">
      <p class="font-mono text-xs uppercase tracking-widest text-muted">Helpful to include</p>
      <ol class="mt-6 border-t border-line">
        {
          intake.map((question, index) => (
            <li class="grid grid-cols-[3rem_1fr] items-baseline gap-4 border-b border-line py-4">
              <span class="font-mono text-xs text-muted">{`0${index + 1}`}</span>
              <span class="text-muted">{question}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mt-16">
      <p class="font-mono text-xs uppercase tracking-widest text-muted">Elsewhere</p>
      <ul class="mt-6 space-y-2 text-sm">
        <li>
          <a href={site.socials.linkedin} rel="me" class="text-muted transition-colors hover:text-fg">
            LinkedIn - linkedin.com/in/iAmBalvinder
          </a>
        </li>
        <li>
          <a href={site.socials.github} rel="me" class="text-muted transition-colors hover:text-fg">
            GitHub - github.com/iAmBalvinder
          </a>
        </li>
      </ul>
      <p class="mt-8 text-sm text-muted">
        A contact form is coming in an upcoming update. For now, email works best.
      </p>
    </div>
  </section>
</BaseLayout>
