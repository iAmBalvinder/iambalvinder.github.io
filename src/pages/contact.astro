---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const intake = [
  'What are you building, and for whom?',
  'Where is it stuck today - demo, prototype, or production?',
  'What does your current data stack look like?',
  'What is the timeline you are working against?',
];
---

<BaseLayout title="Contact" description="Get in touch about LLM and AI consulting: architecture reviews, RAG and eval pipelines, data platform enablement, and roadmaps.">
  <section class="mx-auto max-w-3xl px-6 pt-24 pb-20 sm:pt-32">
    <p class="text-sm font-medium tracking-widest text-accent uppercase">Contact</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
      Let's talk about your project
    </h1>
    <p class="mt-6 text-lg text-muted">
      The fastest way to reach me is email. Include a few lines about your project
      and I will reply within one or two business days. If it looks like a fit,
      the first call is free.
    </p>

    <div class="mt-10">
      <a
        href={`mailto:${site.email}?subject=Consulting%20inquiry`}
        class="inline-flex items-center rounded-xl bg-accent px-6 py-3 font-semibold text-bg transition-colors hover:bg-accent-strong"
      >
        Email {site.email}
      </a>
    </div>

    <div class="mt-14">
      <h2 class="text-sm font-medium tracking-widest text-accent uppercase">
        Helpful to include
      </h2>
      <ul class="mt-4 space-y-3">
        {
          intake.map((question) => (
            <li class="flex gap-3 text-muted">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              <span>{question}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-14 border-t border-line/70 pt-10">
      <h2 class="text-sm font-medium tracking-widest text-accent uppercase">Elsewhere</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href={site.socials.linkedin} rel="me" class="text-muted transition-colors hover:text-fg">
            LinkedIn - linkedin.com/in/iAmBalvinder
          </a>
        </li>
        <li>
          <a href={site.socials.github} rel="me" class="text-muted transition-colors hover:text-fg">
            GitHub - github.com/iAmBalvinder
          </a>
        </li>
      </ul>
      <p class="mt-6 text-sm text-muted">
        A contact form is coming in an upcoming update. For now, email works best.
      </p>
    </div>
  </section>
</BaseLayout>
