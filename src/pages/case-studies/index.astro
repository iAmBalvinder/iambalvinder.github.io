---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const studies = (await getCollection('case-studies'))
  .filter((study) => !study.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
---

<BaseLayout
  title="Case Studies"
  description="Anonymized case studies from real engagements: problem, approach, architecture, and measurable outcomes."
>
  <section class="mx-auto max-w-3xl px-6 pt-24 pb-12 sm:pt-32">
    <p class="font-mono text-xs uppercase tracking-widest text-accent">Case studies</p>
    <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight tracking-tight text-fg sm:text-5xl">
      Problems, approaches, outcomes
    </h1>
    <p class="mt-8 text-lg leading-relaxed text-muted">
      Client names are withheld - the architectures and outcomes are real.
      Details are anonymized where engagements are under NDA.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
    <div class="border-t border-line">
      {
        studies.map((study, index) => (
          <a
            href={`/case-studies/${study.id}/`}
            class="group grid gap-2 border-b border-line py-8 transition-colors hover:bg-surface sm:grid-cols-[5rem_1fr_auto] sm:gap-8"
          >
            <span class="pt-1 font-mono text-xs text-muted">{`0${index + 1}`}</span>
            <div>
              <p class="font-mono text-xs uppercase tracking-widest text-muted">
                {study.data.industry} - {study.data.timeframe}
              </p>
              <h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight text-fg">
                {study.data.title}
              </h2>
              <p class="mt-2 max-w-3xl leading-relaxed text-muted">{study.data.description}</p>
              {
                study.data.outcomes.length > 0 && (
                  <p class="mt-3 font-mono text-xs text-accent">
                    {study.data.outcomes[0].metric.toLowerCase()} &rarr; {study.data.outcomes[0].after.toLowerCase()}
                  </p>
                )
              }
            </div>
            <span
              class="hidden pt-1 font-mono text-sm text-muted transition-colors group-hover:text-accent sm:block"
              aria-hidden="true"
            >
              &rarr;
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <CTASection
    title="Have a problem that looks familiar?"
    body="These engagements all started with a two-sentence email describing where the project was stuck."
  />
</BaseLayout>
