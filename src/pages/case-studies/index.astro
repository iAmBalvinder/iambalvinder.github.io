---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const studies = (await getCollection('case-studies'))
  .filter((study) => !study.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
---

<BaseLayout
  title="Case Studies"
  description="Anonymized case studies from real engagements: problem, approach, architecture, and measurable outcomes."
>
  <section class="mx-auto max-w-3xl px-6 pt-24 pb-12 sm:pt-32">
    <p class="text-sm font-medium tracking-widest text-accent uppercase">Case studies</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
      Problems, approaches, outcomes
    </h1>
    <p class="mt-6 text-lg text-muted">
      Client names are withheld - the architectures and outcomes are real.
      Details are anonymized where engagements are under NDA.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
    <div class="space-y-6">
      {
        studies.map((study) => (
          <a
            href={`/case-studies/${study.id}/`}
            class="group block rounded-2xl border border-line bg-surface p-8 transition-colors hover:border-accent/40"
          >
            <div class="flex flex-wrap items-center gap-3 text-sm text-muted">
              <span>{dateFmt.format(study.data.publishDate)}</span>
              <span class="h-1 w-1 rounded-full bg-line" aria-hidden="true" />
              <span>{study.data.industry}</span>
              <span class="h-1 w-1 rounded-full bg-line" aria-hidden="true" />
              <span>{study.data.timeframe}</span>
            </div>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-fg group-hover:text-accent-strong">
              {study.data.title}
            </h2>
            <p class="mt-3 max-w-3xl text-muted">{study.data.description}</p>
            {
              study.data.outcomes.length > 0 && (
                <ul class="mt-5 flex flex-wrap gap-2" aria-label="Key outcomes">
                  {study.data.outcomes.slice(0, 2).map((outcome) => (
                    <li class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs text-accent-strong">
                      {outcome.metric}: {outcome.after}
                    </li>
                  ))}
                </ul>
              )
            }
            <p class="mt-4 text-sm font-medium text-accent opacity-80 transition-opacity group-hover:opacity-100">
              Read the case study &rarr;
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <CTASection
    title="Have a problem that looks familiar?"
    body="These engagements all started with a two-sentence email describing where the project was stuck."
  />
</BaseLayout>
