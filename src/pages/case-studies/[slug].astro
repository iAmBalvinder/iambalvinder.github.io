---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import CTASection from '../../components/CTASection.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const studies = (await getCollection('case-studies')).filter(
    (study) => !study.data.draft,
  );
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: study.data.title,
  description: study.data.description,
  datePublished: study.data.publishDate,
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
  },
  mainEntityOfPage: new URL(`/case-studies/${study.id}/`, Astro.site),
};
---

<Article
  title={study.data.title}
  description={study.data.description}
  date={study.data.publishDate}
  backHref="/case-studies/"
  backLabel="All case studies"
  jsonLd={jsonLd}
>
  <div
    class="not-prose mb-10 grid gap-4 rounded-2xl border border-line bg-surface p-6 sm:grid-cols-3"
  >
    <div>
      <p class="text-xs font-medium tracking-widest text-muted uppercase">Client</p>
      <p class="mt-1 text-sm text-fg">{study.data.client}</p>
    </div>
    <div>
      <p class="text-xs font-medium tracking-widest text-muted uppercase">Industry</p>
      <p class="mt-1 text-sm text-fg">{study.data.industry}</p>
    </div>
    <div>
      <p class="text-xs font-medium tracking-widest text-muted uppercase">Timeframe</p>
      <p class="mt-1 text-sm text-fg">{study.data.timeframe}</p>
    </div>
  </div>

  {
    study.data.outcomes.length > 0 && (
      <section
        class="not-prose mb-10 rounded-2xl border border-accent/30 bg-accent/5 p-6 sm:p-8"
        aria-labelledby="outcomes"
      >
        <h2 id="outcomes" class="text-sm font-medium tracking-widest text-accent uppercase">
          Outcomes
        </h2>
        <dl class="mt-4 space-y-4">
          {study.data.outcomes.map((outcome) => (
            <div class="rounded-xl border border-line bg-surface p-4">
              <dt class="text-sm font-semibold text-fg">{outcome.metric}</dt>
              <dd class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                {outcome.before && (
                  <span class="text-muted line-through decoration-muted/50">{outcome.before}</span>
                )}
                {outcome.before && <span class="text-accent" aria-hidden="true">&rarr;</span>}
                <span class="text-accent-strong font-medium">{outcome.after}</span>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <Content />

  {
    study.data.stack.length > 0 && (
      <section class="not-prose mt-12 border-t border-line/70 pt-8" aria-labelledby="stack">
        <h2 id="stack" class="text-xs font-medium tracking-widest text-muted uppercase">
          Stack
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {study.data.stack.map((item) => (
            <li class="rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted">
              {item}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Article>

<CTASection
  title="Facing a similar problem?"
  body="Every case study on this page started as an email. Describe yours and I will tell you honestly whether I can help."
/>
