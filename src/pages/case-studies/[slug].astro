---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import CTASection from '../../components/CTASection.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const studies = (await getCollection('case-studies')).filter(
    (study) => !study.data.draft,
  );
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: study.data.title,
  description: study.data.description,
  datePublished: study.data.publishDate,
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
  },
  mainEntityOfPage: new URL(`/case-studies/${study.id}/`, Astro.site),
};
---

<Article
  title={study.data.title}
  description={study.data.description}
  date={study.data.publishDate}
  backHref="/case-studies/"
  backLabel="All case studies"
  jsonLd={jsonLd}
>
  <div class="not-prose mt-10 grid grid-cols-1 gap-x-8 gap-y-4 border-t border-b border-line py-6 sm:grid-cols-3">
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-muted">Client</p>
      <p class="mt-1 text-sm text-fg">{study.data.client}</p>
    </div>
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-muted">Industry</p>
      <p class="mt-1 text-sm text-fg">{study.data.industry}</p>
    </div>
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-muted">Timeframe</p>
      <p class="mt-1 text-sm text-fg">{study.data.timeframe}</p>
    </div>
  </div>

  {
    study.data.outcomes.length > 0 && (
      <section class="not-prose mt-10 border-t border-line pt-8" aria-labelledby="outcomes">
        <h2 id="outcomes" class="font-mono text-xs uppercase tracking-widest text-muted">
          Outcomes
        </h2>
        <dl class="mt-6">
          {study.data.outcomes.map((outcome) => (
            <div class="border-b border-line py-5">
              <dt class="font-serif text-lg font-semibold tracking-tight text-fg">{outcome.metric}</dt>
              <dd class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                {outcome.before && (
                  <span class="text-muted line-through decoration-muted/60">{outcome.before}</span>
                )}
                {outcome.before && <span class="text-accent" aria-hidden="true">&rarr;</span>}
                <span class="font-medium text-accent">{outcome.after}</span>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <Content />

  {
    study.data.stack.length > 0 && (
      <section class="not-prose mt-12 border-t border-line pt-8" aria-labelledby="stack">
        <h2 id="stack" class="font-mono text-xs uppercase tracking-widest text-muted">
          Stack
        </h2>
        <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-2 font-mono text-xs text-muted">
          {study.data.stack.map((item) => (
            <li>{`[ ${item} ]`}</li>
          ))}
        </ul>
      </section>
    )
  }
</Article>

<CTASection
  title="Facing a similar problem?"
  body="Every case study on this page started as an email. Describe yours and I will tell you honestly whether I can help."
/>
