---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description: service.data.description,
  provider: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
  },
  url: new URL(`/services/${service.id}/`, Astro.site),
};
---

<BaseLayout
  title={service.data.title}
  description={service.data.description}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">
    <a
      href="/services/"
      class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-fg"
    >
      <span aria-hidden="true">&larr;</span> All services
    </a>
    <header class="mt-8">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{service.data.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">{service.data.description}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {
          service.data.timeline && (
            <span class="rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted">
              Timeline: {service.data.timeline}
            </span>
          )
        }
        {
          service.data.format && (
            <span class="rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted">
              Format: {service.data.format}
            </span>
          )
        }
      </div>
    </header>

    {
      service.data.deliverables.length > 0 && (
        <section class="mt-10 rounded-2xl border border-line bg-surface p-6 sm:p-8" aria-labelledby="deliverables">
          <h2 id="deliverables" class="text-sm font-medium tracking-widest text-accent uppercase">
            What you get
          </h2>
          <ul class="mt-4 space-y-3">
            {service.data.deliverables.map((item) => (
              <li class="flex gap-3 text-muted">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div
      class="prose prose-invert mt-10 max-w-none
        prose-headings:font-semibold prose-headings:tracking-tight
        prose-a:text-accent prose-a:no-underline prose-a:hover:underline
        prose-strong:text-fg
        prose-code:rounded prose-code:bg-surface prose-code:px-1 prose-code:before:hidden prose-code:after:hidden
        prose-li:text-muted prose-p:text-muted"
    >
      <Content />
    </div>
  </article>

  <CTASection
    title={`Interested in ${service.data.title.toLowerCase()}?`}
    body="Send a two-sentence description of your project. If this engagement is the right fit, the first call is free."
  />
</BaseLayout>
