---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { site } from '../../data/site';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Services"
  description="LLM and AI consulting engagements: architecture reviews, RAG and eval pipelines, data platform enablement, and strategy roadmaps."
>
  <section class="mx-auto max-w-3xl px-6 pt-24 pb-12 sm:pt-32">
    <p class="font-mono text-xs uppercase tracking-widest text-accent">Services</p>
    <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight tracking-tight text-fg sm:text-5xl">
      Engagements that fit real teams
    </h1>
    <p class="mt-8 text-lg leading-relaxed text-muted">
      Four ways to work together, from a two-week review to a multi-month build.
      Every engagement ends with your team owning the system, not depending on me.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
    <div class="border-t border-line">
      {
        services.map((service, index) => (
          <a
            href={`/services/${service.id}/`}
            class="group grid gap-2 border-b border-line py-8 transition-colors hover:bg-surface sm:grid-cols-[5rem_1fr_auto] sm:gap-8"
          >
            <span class="pt-1 font-mono text-xs text-muted">{`0${index + 1}`}</span>
            <div>
              <h2 class="font-serif text-2xl font-semibold tracking-tight text-fg">
                {service.data.title}
              </h2>
              <p class="mt-2 max-w-2xl leading-relaxed text-muted">{service.data.description}</p>
            </div>
            <div class="flex items-start gap-6">
              {service.data.timeline && (
                <span class="hidden pt-1.5 font-mono text-xs text-muted lg:inline">
                  {`[ ${service.data.timeline} ]`}
                </span>
              )}
              <span
                class="hidden pt-1 font-mono text-sm text-muted transition-colors group-hover:text-accent sm:block"
                aria-hidden="true"
              >
                &rarr;
              </span>
            </div>
          </a>
        ))
      }
    </div>
    <p class="mt-10 text-sm text-muted">
      Something else in mind?
      <a href={`mailto:${site.email}?subject=Consulting%20inquiry`} class="text-accent hover:underline">
        Email me
      </a> and describe the problem - if it is not a fit, I will say so and point you elsewhere.
    </p>
  </section>

  <CTASection
    title="Not sure which one you need?"
    body="Describe where your project is stuck in two sentences. I will tell you which engagement fits - or whether you need one at all."
  />
</BaseLayout>
